# Wellbore Knowledge Graph Environment Configuration

# Application
APP_NAME="Wellbore Engineering GraphRAG"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false

# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=wellborepassword123
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# Vector Index Configuration
VECTOR_INDEX_NAME=chunk_vector_index
EMBEDDING_DIMENSION=384
SIMILARITY_METRIC=cosine

# Ollama LLM & Embeddings Provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
FALLBACK_EMBED_PROVIDER=deterministic
ALLOW_MOCK_LLM_FALLBACK=true

# Ingestion & Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval Parameters
DEFAULT_TOP_K_CHUNKS=5
DEFAULT_GRAPH_HOPS=2
MAX_GRAPH_PATHS=25
MIN_SIMILARITY_SCORE=0.35
